{
    "$schema": "https://opencode.ai/config.json",
    "mcp": {
        "cedrus": {
            "type": "local",
            "command": [
                "uvx",
                "cedrus-mcp"
            ],
            "environment": {
                "CEDRUS_SAVE_DIR": "/tmp/maps"
            },
            "enabled": true
        }
    }
}